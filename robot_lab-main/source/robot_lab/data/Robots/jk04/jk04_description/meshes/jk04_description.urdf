<gazebo reference="fl_wheel">
  <material>Gazebo/Rubber</material>
  <mu1 value="1.5"/>  <!-- 静摩擦系数 -->
  <mu2 value="1.5"/>  <!-- 动摩擦系数 -->
  <kp value="1000000.0"/>  <!-- 接触刚度 -->
  <kd value="100.0"/>     <!-- 接触阻尼 -->
  <minDepth value="0.001"/>  <!-- 最小穿透深度 -->
  <maxVel value="1.0"/>      <!-- 最大接触速度 -->
  <slipCompliance value="0.05"/>  <!-- 滑移顺从性 -->
  <fdir1 value="0 0 1"/>      <!-- 各向异性摩擦方向 -->
</gazebo>

